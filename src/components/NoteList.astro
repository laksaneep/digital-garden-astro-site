---
import { byMonth } from "../lib/garden.mjs";

const { notes } = Astro.props;
const groups = byMonth(notes);
---

{
  groups.map((group) => (
    <>
      <p class="month">{group.label}</p>
      {group.notes.map((note) => (
        <a class="row" href={`/notes/${note.slug}`}>
          <span class="rt">{note.data.title}</span>
          <span class="rmeta">
            {note.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            <span class="date">
              {note.data.created.toLocaleDateString("en-GB", { day: "2-digit", month: "short" })}
            </span>
          </span>
        </a>
      ))}
    </>
  ))
}
