---
/*
 * Static full-text search, powered by Pagefind.
 *
 * One modal, two ways in: the nav button (works on touch) and ⌘K / Ctrl+K
 * (works for keyboard). Pagefind's runtime is loaded lazily the first time the
 * modal opens, so every other page still ships no search JS.
 *
 * Pagefind only exists in the *built* output (dist/pagefind/), so search is
 * inert under `astro dev` — test with `npm run build && npm run preview`.
 */
---

<button
  id="pf-open"
  type="button"
  aria-label="Search notes"
  aria-keyshortcuts="Meta+K Control+K"
  class="bg-raised border-line text-muted hover:border-accent hover:text-accent flex h-8 items-center gap-2 border pr-1.5 pl-2.5 text-sm max-md:size-9 max-md:justify-center max-md:rounded-full max-md:border-0 max-md:bg-transparent max-md:p-0 md:ml-3 md:min-w-[220px]"
>
  <svg
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <span class="hidden md:inline">Search</span>
  <kbd
    class="border-line-soft text-faint ml-auto hidden border px-1.5 font-mono text-[11px] leading-5 md:inline"
    >⌘K</kbd
  >
</button>

<div
  id="pf-modal"
  class="fixed inset-0 z-50 hidden px-4 pt-[12vh]"
  role="dialog"
  aria-modal="true"
  aria-label="Search notes"
>
  <div id="pf-backdrop" class="absolute inset-0 bg-black/40"></div>
  <div
    class="bg-raised border-line relative mx-auto flex max-h-[70vh] w-full max-w-[560px] flex-col border shadow-[0_16px_48px_rgba(0,0,0,0.22)]"
  >
    <div class="border-line flex items-center gap-2.5 border-b px-4">
      <svg
        class="text-faint size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="pf-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search notes…"
        class="text-ink placeholder:text-faint h-13 flex-1 bg-transparent text-[16px] outline-none md:text-[15px]"
      />
      <kbd
        class="border-line-soft text-faint hidden border px-1.5 font-mono text-[11px] leading-5 sm:inline"
        >esc</kbd
      >
    </div>
    <div id="pf-results" class="overflow-y-auto"></div>
  </div>
</div>

<style is:global>
  #pf-results:empty {
    display: none;
  }
  #pf-results .pf-msg {
    color: var(--muted);
    font-size: 14px;
    padding: 16px;
    margin: 0;
  }
  #pf-results .pf-result {
    display: block;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
  }
  #pf-results .pf-result:last-child {
    border-bottom: 0;
  }
  #pf-results .pf-result[data-active="true"] {
    background-color: var(--sunk);
  }
  #pf-results .pf-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  #pf-results .pf-title {
    color: var(--ink);
    font-size: 15px;
    line-height: var(--cell);
  }
  #pf-results .pf-result[data-active="true"] .pf-title {
    color: var(--accent);
  }
  #pf-results .pf-section {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
  }
  #pf-results .pf-excerpt {
    color: var(--muted);
    font-size: 13px;
    line-height: 20px;
    margin: 2px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #pf-results .pf-excerpt mark {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  (() => {
    const openBtn = document.getElementById("pf-open");
    const modal = document.getElementById("pf-modal");
    const backdrop = document.getElementById("pf-backdrop");
    const input = document.getElementById("pf-input");
    const results = document.getElementById("pf-results");
    if (!openBtn || !modal || !backdrop || !input || !results) return;

    let pagefind = null;
    let active = -1;

    const titleCase = (s) => s.charAt(0).toUpperCase() + s.slice(1);
    const escape = (s) =>
      s.replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );

    async function load() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import(/* @vite-ignore */ "/pagefind/pagefind.js");
        await pagefind.init();
      } catch {
        pagefind = null;
        results.innerHTML =
          '<p class="pf-msg">Search runs on the built site — try <code>npm run build &amp;&amp; npm run preview</code>.</p>';
      }
      return pagefind;
    }

    const isOpen = () => !modal.classList.contains("hidden");

    function open() {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      input.focus();
      load();
    }

    function close() {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
      input.value = "";
      results.innerHTML = "";
      active = -1;
    }

    openBtn.addEventListener("click", open);
    backdrop.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen() ? close() : open();
      } else if (e.key === "Escape" && isOpen()) {
        close();
      }
    });

    let timer;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 120);
    });

    async function run() {
      const q = input.value.trim();
      active = -1;
      if (!q) {
        results.innerHTML = "";
        return;
      }
      const pf = await load();
      if (!pf) return;
      const search = await pf.search(q);
      const items = await Promise.all(
        search.results.slice(0, 8).map((r) => r.data()),
      );
      if (input.value.trim() !== q) return; // a newer query already ran
      render(items, q);
    }

    function render(items, q) {
      if (!items.length) {
        results.innerHTML = `<p class="pf-msg">No matches for “${escape(q)}”.</p>`;
        return;
      }
      results.innerHTML = items
        .map((item, i) => {
          const title = escape(item.meta?.title ?? item.url);
          const section = item.meta?.section
            ? `<span class="pf-section">${escape(titleCase(item.meta.section))}</span>`
            : "";
          return `<a class="pf-result" href="${item.url}" data-idx="${i}">
            <span class="pf-row"><span class="pf-title">${title}</span>${section}</span>
            <p class="pf-excerpt">${item.excerpt}</p>
          </a>`;
        })
        .join("");
    }

    function move(delta) {
      const links = [...results.querySelectorAll(".pf-result")];
      if (!links.length) return;
      active = (active + delta + links.length) % links.length;
      links.forEach((l, i) =>
        l.setAttribute("data-active", i === active ? "true" : "false"),
      );
      links[active].scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const links = [...results.querySelectorAll(".pf-result")];
        const target = links[active] ?? links[0];
        if (target) {
          e.preventDefault();
          window.location.href = target.getAttribute("href");
        }
      }
    });
  })();
</script>
