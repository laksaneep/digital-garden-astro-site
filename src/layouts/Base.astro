---
import "../styles/global.css";
import { cn } from "../lib/utils";

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const navLink =
  "flex h-8 items-center px-2.5 text-sm text-muted no-underline hover:text-accent";
const navLinkActive = "text-ink shadow-[inset_0_-2px_0_var(--accent)]";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>🌱</text></svg>"
    />
    {
      /* Runs before first paint so a saved theme never flashes the wrong one. */
    }
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>
  <body>
    <div class="mx-auto max-w-[1080px] px-6 pb-24">
      <header
        class="border-line flex h-18 flex-wrap items-center justify-between gap-4 border-b"
      >
        <a
          class="font-display text-ink text-[17px] font-semibold tracking-[-0.01em] no-underline"
          href="/">what i've learned today</a
        >
        <hr class="border-line-soft m-0 flex-1 border-0 border-t" />
        <nav class="flex items-center gap-1">
          <a
            href="/notes"
            class={cn(navLink, path.startsWith("/notes") && navLinkActive)}
            aria-current={path.startsWith("/notes") ? "page" : undefined}
            >notes</a
          >
          <a
            href="/tags"
            class={cn(navLink, path.startsWith("/tags") && navLinkActive)}
            aria-current={path.startsWith("/tags") ? "page" : undefined}
            >tags</a
          >
          <button
            id="theme-toggle"
            type="button"
            aria-label="Switch theme"
            class="bg-raised border-line text-muted hover:border-accent hover:text-accent ml-1 flex size-8 cursor-pointer items-center justify-center border p-0"
          >
            <svg
              class="icon-moon block size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg
              class="icon-sun hidden size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
          </button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>

    {
      /* Show the icon for the theme you'd switch *to*, so the button reads as
         an action. Driven by the same signals as the palette above. */
    }
    <style is:global>
      :root[data-theme="dark"] .icon-sun {
        display: block;
      }
      :root[data-theme="dark"] .icon-moon {
        display: none;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) .icon-sun {
          display: block;
        }
        :root:not([data-theme]) .icon-moon {
          display: none;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");

        const active = () =>
          root.dataset.theme ||
          (matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        const label = () =>
          button.setAttribute(
            "aria-label",
            active() === "dark"
              ? "Switch to light theme"
              : "Switch to dark theme",
          );

        button.addEventListener("click", () => {
          const next = active() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          localStorage.setItem("theme", next);
          label();
        });

        // Follow the OS until the user makes an explicit choice.
        matchMedia("(prefers-color-scheme: dark)").addEventListener(
          "change",
          () => {
            if (!localStorage.getItem("theme")) label();
          },
        );

        label();
      })();
    </script>
  </body>
</html>
