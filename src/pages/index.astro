---
import Base from "../layouts/Base.astro";
import NoteList from "../components/NoteList.astro";
import Heatmap from "../components/Heatmap.astro";
import { getNotes, sectionCounts, titleCase } from "../lib/garden.mjs";

const notes = await getNotes();
const sections = sectionCounts(notes);
const recent = notes.slice(0, 10);
---

<Base
  title="What I've learned today"
  description="A garden of small things I've figured out."
>
  <h1
    class="font-display mt-12 mb-6 text-[32px] leading-12 font-semibold tracking-[-0.02em] text-balance max-[520px]:text-[26px]"
  >
    A garden of small things I've figured out.
  </h1>
  <p class="text-muted mb-12 max-w-[54ch]">
    Mostly frontend, sometimes backend, occasionally something I'll need to
    relearn next year. Nothing here is finished.
  </p>

  {
    sections.length > 0 && (
      <section class="mb-12">
        <p class="text-faint mb-3 font-mono text-[11px] leading-6 tracking-[0.11em] uppercase">
          Sections
        </p>
        <div class="flex flex-wrap gap-2">
          {sections.map((section) => (
            <a
              class="bg-raised text-ink border-line hover:border-accent hover:text-accent group flex h-10 items-center gap-2 border px-3.5 text-sm no-underline"
              href={`/sections/${section.slug}`}
            >
              {titleCase(section.name)}
              <b class="text-muted group-hover:text-accent font-mono text-[12.5px] font-medium tabular-nums">
                {section.count}
              </b>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-12">
    <div class="bg-sunk border-line flex items-baseline gap-2.5 border px-4.5 py-3">
      <b class="font-display text-[28px] leading-6 font-semibold tabular-nums">
        {notes.length}
      </b>
      <span class="text-muted text-sm">
        {notes.length === 1 ? "note planted so far" : "notes planted so far"}
      </span>
    </div>
  </section>

  <section class="mb-12">
    <p class="text-faint mb-3 font-mono text-[11px] leading-6 tracking-[0.11em] uppercase">
      Activity
    </p>
    <Heatmap notes={notes} />
  </section>

  <section class="mb-12">
    <p class="text-faint mb-3 font-mono text-[11px] leading-6 tracking-[0.11em] uppercase">
      Recently
    </p>
    {
      recent.length > 0 ? (
        <NoteList notes={recent} />
      ) : (
        <p class="text-muted m-0 text-[14.5px]">
          Nothing published yet. Add a note with <code>published: true</code>.
        </p>
      )
    }
  </section>
</Base>
