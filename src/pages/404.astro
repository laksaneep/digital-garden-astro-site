---
import Base from "../layouts/Base.astro";
import { getNotes } from "../lib/garden.mjs";

// Cloudflare Pages serves dist/404.html for any path that doesn't exist, with
// a real 404 status. Offer a few fresh notes so a dead end still leads somewhere.
const recent = (await getNotes()).slice(0, 5);
---

<Base title="Not found — What I've learned today">
  <p class="text-faint mt-12 mb-0 font-mono text-[11px] leading-6 tracking-[0.11em] uppercase">
    404 · nothing planted here
  </p>
  <h1
    class="font-display mt-0 mb-6 text-[32px] leading-12 font-semibold tracking-[-0.02em] text-balance max-[520px]:text-[26px]"
  >
    This patch of the garden is still bare
  </h1>
  <p class="text-muted mb-6 max-w-[54ch]">
    The page you followed doesn't exist. Maybe the note was renamed, or it's
    still a seedling that hasn't been published yet.
  </p>
  <p class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a class="text-accent border-accent-soft hover:border-accent border-b no-underline" href="/notes"
      >Browse all notes</a
    >
    <a class="text-accent border-accent-soft hover:border-accent border-b no-underline" href="/tags"
      >Look through tags</a
    >
    <a class="text-accent border-accent-soft hover:border-accent border-b no-underline" href="/"
      >Go home</a
    >
  </p>

  {
    recent.length > 0 && (
      <>
        <p class="text-faint mb-0 font-mono text-[11px] leading-6 tracking-[0.11em] uppercase">
          Recently planted
        </p>
        {recent.map((note) => (
          <a
            class="border-line-soft text-ink group flex min-h-12 items-baseline justify-between gap-[18px] border-b py-3 no-underline"
            href={`/notes/${note.slug}`}
          >
            <span class="note-title text-[15.5px] group-hover:text-accent">
              {note.data.title}
            </span>
            <span class="text-faint font-mono text-xs whitespace-nowrap tabular-nums">
              {note.data.created.toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "short",
              })}
            </span>
          </a>
        ))}
      </>
    )
  }
</Base>
