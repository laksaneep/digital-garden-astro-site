---
import Base from "../../layouts/Base.astro";
import { getNotes, tagCounts } from "../../lib/garden.mjs";

const notes = await getNotes();
const tags = tagCounts(notes);
---

<Base title="Tags — What I've learned today">
  <h1
    class="font-display mt-12 mb-6 text-[32px] leading-12 font-semibold tracking-[-0.02em] text-balance max-[520px]:text-[26px]"
  >
    Tags
  </h1>
  <p class="text-muted mb-12 max-w-[54ch]">
    Every tag in the garden, most used first.
  </p>

  {
    tags.length > 0 ? (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            class="bg-raised text-ink border-line hover:border-accent hover:text-accent group flex h-10 items-center gap-2 border px-3.5 text-sm no-underline"
            href={`/tags/${tag.slug}`}
          >
            {tag.name}
            <b class="text-muted group-hover:text-accent font-mono text-[12.5px] font-medium tabular-nums">
              {tag.count}
            </b>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-muted m-0 text-[14.5px]">No tags yet.</p>
    )
  }
</Base>
