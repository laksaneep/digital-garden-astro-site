---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getNotes, backlinksTo } from "../../lib/garden.mjs";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note, notes },
  }));
}

const { note, notes } = Astro.props;
const { Content } = await render(note);
const backlinks = backlinksTo(note, notes);
---

<Base title={`${note.data.title} — What I've learned today`}>
  <article>
    <h1
      class="font-display mt-6 mb-6 text-[32px] leading-12 font-semibold tracking-[-0.02em] text-balance max-[520px]:text-[26px]"
    >
      {note.data.title}
    </h1>
    <div class="mb-12 flex flex-wrap items-center gap-2.5">
      <span class="text-faint font-mono text-xs whitespace-nowrap tabular-nums">
        {note.data.created.toISOString().slice(0, 10)}
      </span>
      {
        note.data.tags.map((tag) => (
          <span class="text-muted bg-sunk border-line-soft border px-[7px] py-px font-mono text-[11px]">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="prose">
      <Content />
    </div>

    <div class="border-line mt-12 border-t pt-6">
      <p class="text-faint mb-3 font-mono text-[11px] leading-6 tracking-[0.11em] uppercase">
        Linked from
      </p>
      {
        backlinks.length > 0 ? (
          backlinks.map((other) => (
            <a
              class="border-line-soft text-ink group flex min-h-12 items-baseline justify-between gap-[18px] border-b py-3 no-underline"
              href={`/notes/${other.slug}`}
            >
              <span class="note-title text-[15.5px] group-hover:text-accent">
                {other.data.title}
              </span>
              <span class="text-faint font-mono text-xs whitespace-nowrap tabular-nums">
                {other.data.created.toLocaleDateString("en-GB", {
                  day: "2-digit",
                  month: "short",
                })}
              </span>
            </a>
          ))
        ) : (
          <p class="text-muted m-0 text-[14.5px]">Nothing links here yet.</p>
        )
      }
    </div>

    <a
      class="text-muted hover:text-accent mt-6 inline-block text-sm no-underline"
      href="/notes">← all notes</a
    >
  </article>
</Base>
