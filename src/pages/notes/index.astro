---
import Base from "../../layouts/Base.astro";
import NoteList from "../../components/NoteList.astro";
import { getNotes } from "../../lib/garden.mjs";

const notes = await getNotes();
---

<Base title="All notes — What I've learned today">
  <h1
    class="font-display mt-12 mb-6 text-[32px] leading-12 font-semibold tracking-[-0.02em] text-balance max-[520px]:text-[26px]"
  >
    All notes
  </h1>
  <p class="text-muted mb-12 max-w-[54ch]">
    Everything in the garden, newest first.
  </p>
  {
    notes.length > 0 ? (
      <NoteList notes={notes} />
    ) : (
      <p class="text-muted m-0 text-[14.5px]">Nothing published yet.</p>
    )
  }
</Base>
