    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  },
  "overrides": {
    "devalue": "5.9.3",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "smol-toml": "1.7.1",
    "source-map-js": "1.2.2",
    "vite": "6.4.5",
    "svgo": "4.1.0"
